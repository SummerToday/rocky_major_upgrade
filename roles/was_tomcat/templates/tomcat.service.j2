# Managed by Ansible (rocky_major_upgrade). Do not edit by hand.
# Mirrors the unit of the old VM; JAVA_HOME and CATALINA_* are exported by bin/setenv.sh.
[Unit]
Description=Apache Tomcat {{ tomcat_version | regex_replace('^([0-9]+).*', '\\1') }}
After=network.target

[Service]
Type=forking
User={{ tomcat_user }}
Group={{ tomcat_group }}
Environment=CATALINA_PID={{ tomcat_home }}/temp/tomcat.pid
ExecStart={{ tomcat_home }}/bin/startup.sh
ExecStop={{ tomcat_home }}/bin/shutdown.sh
PIDFile={{ tomcat_home }}/temp/tomcat.pid
Restart=on-failure
RestartSec=10
# Tomcat exits with 143 on SIGTERM, which is a normal stop
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
