# Managed by Ansible (rocky_major_upgrade). Do not edit by hand.
# TLS (mod_ssl) is installed but not configured here: add a certificate signed with
# SHA-256 or stronger, because Rocky 9 rejects SHA-1 signatures by default.
{% if apache_http_port | int != 80 %}
# httpd.conf already contains "Listen 80"; a duplicate would stop httpd from starting
Listen {{ apache_http_port }}
{% endif %}

<VirtualHost *:{{ apache_http_port }}>
    ServerName {{ apache_server_name }}
    ErrorLog logs/{{ apache_server_name }}_error.log
    CustomLog logs/{{ apache_server_name }}_access.log combined
{% if apache_proxy_rules | length > 0 %}
    ProxyPreserveHost On
{% for rule in apache_proxy_rules %}
    ProxyPass        "{{ rule.path }}" "{{ rule.target }}"
    ProxyPassReverse "{{ rule.path }}" "{{ rule.target }}"
{% endfor %}
{% endif %}
</VirtualHost>
